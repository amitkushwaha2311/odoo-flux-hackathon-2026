# =============================================================================
# Brightloop — Environment Configuration Example
#
# Copy this file to .env and fill in real values before starting containers.
# The .env file must NEVER be committed to version control.
#
#   cp .env.example .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL credentials
# Must match between the db and odoo services.
# -----------------------------------------------------------------------------
POSTGRES_DB=brightloop_dev
POSTGRES_USER=brightloop
# SECURITY: Use a strong, randomly generated password in all environments.
# Example generator: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_before_use

# -----------------------------------------------------------------------------
# Odoo master password
# Used to manage databases via the Odoo web admin panel.
# SECURITY: Must be changed before first use.
# -----------------------------------------------------------------------------
ODOO_MASTER_PASSWORD=change_me_before_use

# -----------------------------------------------------------------------------
# Odoo development flags (local dev only)
# Remove or set to False in staging/production.
# -----------------------------------------------------------------------------
# ODOO_DEV_MODE=assets
