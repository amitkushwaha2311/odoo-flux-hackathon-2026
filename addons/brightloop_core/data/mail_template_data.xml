<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ================================================================= -->
        <!-- Brightloop Password Reset Email Template                          -->
        <!-- ================================================================= -->
        <record id="mail_template_password_reset" model="mail.template">
            <field name="name">Brightloop: Password Reset Instructions</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Brightloop — Password Reset Request</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent to customers or staff requesting a password reset</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.5;">
                    <p>Hello <t t-out="object.name or 'User'"/>,</p>
                    <p>A password reset request has been received for your Brightloop account (<t t-out="object.email"/>).</p>
                    <p>This request was generated on <t t-out="ctx.get('request_time', 'recently')"/>.</p>
                    <p>Use your single-use verification token to complete the password reset process. This token expires in 1 hour.</p>
                    <p style="margin: 20px 0; padding: 12px; background-color: #f4f6f8; border-left: 4px solid #0052cc; font-family: monospace; font-size: 16px;">
                        Token: <strong t-out="ctx.get('token', '')"/>
                    </p>
                    <p>If you did not request this password reset, please ignore this email. Your password will remain unchanged.</p>
                    <p style="color: #888888; font-size: 12px; margin-top: 30px;">
                        Brightloop Subscription Intelligence — Security Notification
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>

