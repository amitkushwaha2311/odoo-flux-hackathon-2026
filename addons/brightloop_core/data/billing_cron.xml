<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ================================================================= -->
        <!-- Cron: Process Recurring Invoicing for Due Subscriptions           -->
        <!-- ================================================================= -->
        <record id="ir_cron_process_due_billing" model="ir.cron">
            <field name="name">Brightloop: Process Due Recurring Subscriptions</field>
            <field name="model_id" ref="model_brightloop_billing_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_due_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- ================================================================= -->
        <!-- Cron: Retry Failed Recurring Billing Periods                      -->
        <!-- ================================================================= -->
        <record id="ir_cron_retry_failed_billing" model="ir.cron">
            <field name="name">Brightloop: Retry Failed Billing Periods</field>
            <field name="model_id" ref="model_brightloop_billing_period"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed_periods()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

