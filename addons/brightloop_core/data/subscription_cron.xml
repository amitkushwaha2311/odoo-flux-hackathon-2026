<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ================================================================= -->
        <!-- Cron: Auto-Close Eligible Expired Subscriptions                   -->
        <!-- ================================================================= -->
        <record id="ir_cron_auto_close_subscriptions" model="ir.cron">
            <field name="name">Brightloop: Auto-Close Expired Subscriptions</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_close_eligible_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

