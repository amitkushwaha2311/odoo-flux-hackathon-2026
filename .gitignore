# Virtual environment directories (do not commit these)
venv/
.venv/
env/
ENV/
.env
*.env

# =============================================================================
# Python bytecode
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

